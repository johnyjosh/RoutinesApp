<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Luminous Routine Chronometer Loop -->
    <path
        android:pathData="M 54,30 A 24,24 0 1,1 36,37.5"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="30"
                android:startY="30"
                android:endX="78"
                android:endY="78"
                android:type="linear">
                <item android:offset="0.0" android:color="#00E5FF" />
                <item android:offset="0.6" android:color="#B388FF" />
                <item android:offset="1.0" android:color="#FF6E40" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Routine Step Milestone Dots on the Loop -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 78,54 m -2.5,0 a 2.5,2.5 0 1,0 5,0 a 2.5,2.5 0 1,0 -5,0" />
    <path
        android:fillColor="#B388FF"
        android:pathData="M 54,78 m -2.5,0 a 2.5,2.5 0 1,0 5,0 a 2.5,2.5 0 1,0 -5,0" />
    <path
        android:fillColor="#00E5FF"
        android:pathData="M 30,54 m -2.5,0 a 2.5,2.5 0 1,0 5,0 a 2.5,2.5 0 1,0 -5,0" />

    <!-- Center Clock Pivot -->
    <path
        android:fillColor="#00E5FF"
        android:pathData="M 54,54 m -3.5,0 a 3.5,3.5 0 1,0 7,0 a 3.5,3.5 0 1,0 -7,0" />

    <!-- Clock Hour Hand -->
    <path
        android:pathData="M 54,54 L 54,41"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:strokeColor="#FFFFFF" />

    <!-- Clock Minute Hand -->
    <path
        android:pathData="M 54,54 L 66,46"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:strokeColor="#00E5FF" />

    <!-- Summit Sparkle Star -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 54,19 Q 54,24 59,24 Q 54,24 54,29 Q 54,24 49,24 Q 54,24 54,19 Z" />

</vector>
